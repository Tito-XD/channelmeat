---
const taokouling = '77₤t2G8gCNFhNw₴';
const taobaoShareText = `【淘宝】${taokouling} https://m.tb.cn/h.8ghfjzEU1ag8rxX HU287 肉食狗小分队`;

const links = [
  {
    name: '小红书',
    url: 'https://xhslink.cn/m/8mrKDfG2BuD',
    icon: '/assets/icons/xiaohongshu.svg',
    color: '#FF2442',
    type: 'link',
  },
  {
    name: '抖音',
    url: 'https://v.douyin.com/9eig9TCj_-4/',
    icon: '/assets/icons/douyin.svg',
    color: '#161823',
    type: 'link',
  },
  {
    name: '微博',
    url: 'https://weibo.com/u/6042122549',
    icon: '/assets/icons/weibo.svg',
    color: '#E6162D',
    type: 'link',
  },
  {
    name: '淘宝店铺',
    desc: '点击复制淘口令',
    url: 'https://m.tb.cn/h.8ghfjzEU1ag8rxX',
    icon: '/assets/icons/taobao.svg',
    color: '#FF5000',
    type: 'taobao',
  },
];
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>肉食狗小分队 CHANNEL MEAT · 官方链接聚合</title>
    <meta name="description" content="肉食狗小分队 CHANNEL MEAT — Furry 制品社团官方链接聚合页。小红书 / 抖音 / 微博 / 淘宝店铺。" />
    <link rel="icon" type="image/jpeg" href="/assets/logo-meat.jpg" />
    <style>
      :root {
        --red: #f2402f;
        --ink: #1d1d1f;
        --paper: #ececec;
        --card: #ffffff;
      }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html, body { height: 100%; }
      body {
        font-family: "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Noto Sans SC", system-ui, sans-serif;
        color: var(--ink);
        background-color: var(--paper);
        /* 半调网点背景 */
        background-image:
          radial-gradient(circle at 25% 20%, rgba(0,0,0,0.055) 1.6px, transparent 1.7px),
          radial-gradient(circle at 75% 80%, rgba(0,0,0,0.04) 1.4px, transparent 1.5px);
        background-size: 22px 22px, 18px 18px;
        min-height: 100vh;
        display: flex;
        justify-content: center;
        position: relative;
        overflow-x: hidden;
      }
      /* 巨大的 M 水印 */
      .watermark {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        font-size: 130vw;
        font-weight: 900;
        line-height: 1;
        color: transparent;
        -webkit-text-stroke: 2px rgba(0, 0, 0, 0.05);
        user-select: none;
        pointer-events: none;
        z-index: 0;
      }
      .page {
        position: relative;
        z-index: 1;
        width: 100%;
        max-width: 460px;
        padding: 64px 22px 48px;
        display: flex;
        flex-direction: column;
        align-items: center;
      }
      /* 顶部 LOGO：贴纸感 */
      .logo {
        width: 132px;
        height: 132px;
        border-radius: 28px;
        border: 5px solid #fff;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.14);
        object-fit: cover;
        transform: rotate(-2deg);
      }
      h1 {
        margin-top: 26px;
        font-size: 30px;
        font-weight: 900;
        letter-spacing: 2px;
      }
      .handle {
        margin-top: 12px;
        font-size: 13px;
        font-weight: 800;
        letter-spacing: 3px;
        color: #fff;
        background: var(--red);
        padding: 4px 14px;
        border-radius: 999px;
        box-shadow: 0 3px 0 rgba(0,0,0,0.12);
      }
      .bio {
        margin-top: 18px;
        font-size: 14px;
        color: #555;
        text-align: center;
        line-height: 1.7;
      }
      .bio .slogan {
        display: block;
        margin-top: 4px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 2.5px;
        color: #999;
      }
      /* 链接卡片 */
      .links {
        margin-top: 38px;
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 18px;
      }
      .card {
        display: flex;
        align-items: center;
        gap: 16px;
        width: 100%;
        padding: 20px 22px;
        background: var(--card);
        border: 3px solid #fff;
        border-radius: 18px;
        box-shadow: 0 4px 0 rgba(0, 0, 0, 0.10), 0 10px 22px rgba(0, 0, 0, 0.06);
        text-decoration: none;
        color: var(--ink);
        cursor: pointer;
        transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
        -webkit-tap-highlight-color: transparent;
      }
      .card:hover {
        transform: translateY(-3px) rotate(-0.4deg);
        border-color: var(--red);
        box-shadow: 0 7px 0 rgba(242, 64, 47, 0.25), 0 14px 26px rgba(0, 0, 0, 0.08);
      }
      .card:active { transform: translateY(0) scale(0.985); }
      .badge {
        flex: none;
        width: 46px;
        height: 46px;
        border-radius: 13px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: inset 0 -3px 0 rgba(0, 0, 0, 0.15);
      }
      .badge img {
        width: 24px;
        height: 24px;
        display: block;
      }
      .card-text { flex: 1; min-width: 0; text-align: left; }
      .card-name { font-size: 17px; font-weight: 800; }
      .card-desc { margin-top: 2px; font-size: 12px; color: #888; }
      .arrow {
        flex: none;
        font-size: 18px;
        font-weight: 900;
        color: #bbb;
        transition: color 0.15s ease, transform 0.15s ease;
      }
      .card:hover .arrow { color: var(--red); transform: translateX(3px); }
      /* 底部 */
      footer {
        margin-top: 44px;
        text-align: center;
        font-size: 11px;
        letter-spacing: 2px;
        color: #999;
        line-height: 2;
      }
      footer .paw { color: var(--red); font-weight: 900; }
      /* 弹窗 */
      .modal-mask {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.45);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.2s ease;
        z-index: 10;
      }
      .modal-mask.show { opacity: 1; pointer-events: auto; }
      .modal {
        width: 100%;
        max-width: 340px;
        background: #fff;
        border-radius: 22px;
        border: 4px solid var(--red);
        padding: 28px 24px 22px;
        text-align: center;
        transform: translateY(12px) scale(0.96);
        transition: transform 0.2s ease;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.25);
      }
      .modal-mask.show .modal { transform: translateY(0) scale(1); }
      .modal-emoji { font-size: 40px; }
      .modal-title {
        margin-top: 10px;
        font-size: 19px;
        font-weight: 900;
      }
      .modal-title em { color: var(--red); font-style: normal; }
      .modal-code {
        margin: 14px auto 0;
        display: inline-block;
        font-size: 13px;
        font-weight: 700;
        color: #b35900;
        background: #fff4e8;
        border: 1.5px dashed #ff5000;
        border-radius: 10px;
        padding: 8px 14px;
        word-break: break-all;
      }
      .modal-tip { margin-top: 12px; font-size: 13px; color: #777; line-height: 1.7; }
      .modal-actions {
        margin-top: 18px;
        display: flex;
        gap: 10px;
      }
      .btn {
        flex: 1;
        border: none;
        border-radius: 12px;
        padding: 12px 0;
        font-size: 15px;
        font-weight: 800;
        font-family: inherit;
        cursor: pointer;
        transition: transform 0.12s ease;
      }
      .btn:active { transform: scale(0.96); }
      .btn-primary { background: #ff5000; color: #fff; box-shadow: 0 4px 0 #c23b00; }
      .btn-ghost { background: #f1f1f1; color: #555; box-shadow: 0 4px 0 #d4d4d4; }
    </style>
  </head>
  <body>
    <div class="watermark" aria-hidden="true">M</div>

    <main class="page">
      <img class="logo" src="/assets/logo-meat.jpg" alt="肉食狗小分队 CHANNEL MEAT LOGO" />
      <h1>肉食狗小分队</h1>
      <div class="handle">CHANNEL MEAT</div>
      <p class="bio">
        Furry 制品社团 · 做热情有趣的制品 🐾
        <span class="slogan">SEEK FOR MEAT · STAY FOR MEET</span>
      </p>

      <nav class="links">
        {links.map((item) =>
          item.type === 'link' ? (
            <a class="card" href={item.url} target="_blank" rel="noopener noreferrer">
              <span class="badge" style={`background:${item.color}`}><img src={item.icon} alt="" /></span>
              <span class="card-text">
                <span class="card-name">{item.name}</span>
                {item.desc && <span class="card-desc" style="display:block">{item.desc}</span>}
              </span>
              <span class="arrow">↗</span>
            </a>
          ) : (
            <button class="card" id="taobao-btn" type="button" data-url={item.url} data-copy={taobaoShareText}>
              <span class="badge" style={`background:${item.color}`}><img src={item.icon} alt="" /></span>
              <span class="card-text">
                <span class="card-name">{item.name}</span>
                <span class="card-desc" style="display:block">{item.desc}</span>
              </span>
              <span class="arrow">⧉</span>
            </button>
          )
        )}
      </nav>

      <footer>
        <div><span class="paw">✳</span> @肉食狗小分队 · CHANNEL MEAT</div>
        <div>channelme.at</div>
      </footer>
    </main>

    <!-- 淘口令弹窗 -->
    <div class="modal-mask" id="modal-mask" role="dialog" aria-modal="true">
      <div class="modal">
        <div class="modal-emoji">🥩</div>
        <div class="modal-title"><em>已复制淘口令</em></div>
        <div class="modal-code" id="modal-code">{taokouling}</div>
        <p class="modal-tip">打开淘宝，自动跳转到店铺<br />若没有跳转，请在淘宝搜索框粘贴</p>
        <div class="modal-actions">
          <button class="btn btn-ghost" id="modal-close" type="button">先逛逛</button>
          <button class="btn btn-primary" id="modal-open" type="button">打开淘宝</button>
        </div>
      </div>
    </div>

    <script>
      const mask = document.getElementById('modal-mask');
      const taobaoBtn = document.getElementById('taobao-btn');
      const closeBtn = document.getElementById('modal-close');
      const openBtn = document.getElementById('modal-open');

      async function copyText(text) {
        try {
          await navigator.clipboard.writeText(text);
          return true;
        } catch (e) {
          // 兼容旧浏览器
          const ta = document.createElement('textarea');
          ta.value = text;
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.select();
          try { document.execCommand('copy'); } catch (_) {}
          document.body.removeChild(ta);
          return true;
        }
      }

      taobaoBtn?.addEventListener('click', async () => {
        await copyText(taobaoBtn.dataset.copy || '');
        mask?.classList.add('show');
      });
      closeBtn?.addEventListener('click', () => mask?.classList.remove('show'));
      mask?.addEventListener('click', (e) => {
        if (e.target === mask) mask.classList.remove('show');
      });
      openBtn?.addEventListener('click', () => {
        const url = taobaoBtn?.dataset.url;
        if (url) window.open(url, '_blank', 'noopener');
      });
    </script>
  </body>
</html>
