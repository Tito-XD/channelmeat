---
const taokouling = '77₤t2G8gCNFhNw₴';
const taobaoShareText = `【淘宝】${taokouling} https://m.tb.cn/h.8ghfjzEU1ag8rxX HU287 肉食狗小分队`;
const taobaoUrl = 'https://m.tb.cn/h.8ghfjzEU1ag8rxX';

const links = [
  {
    key: 'xhs',
    name: '小红书',
    desc: '进入官方主页',
    url: 'https://xhslink.cn/m/8mrKDfG2BuD',
    icon: '/assets/icons/apps/xhs.jpg',
    accent: '#ff3151',
    type: 'preview',
  },
  {
    key: 'douyin',
    name: '抖音',
    desc: '进入官方主页',
    url: 'https://v.douyin.com/9eig9TCj_-4/',
    icon: '/assets/icons/apps/douyin.jpg',
    accent: '#17171a',
    type: 'preview',
  },
  {
    key: 'weibo',
    name: '微博',
    desc: '进入官方主页',
    url: 'https://weibo.com/u/6042122549',
    icon: '/assets/icons/apps/weibo.jpg',
    accent: '#e6162d',
    type: 'preview',
  },
  {
    key: 'taobao',
    name: '淘宝店铺',
    desc: '点击复制淘口令',
    url: 'https://m.tb.cn/h.8ghfjzEU1ag8rxX',
    icon: '/assets/icons/apps/taobao.jpg',
    accent: '#ff5000',
    type: 'taobao',
  },
];
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#e5e6e6" />
    <title>CHANNEL MEAT · Link Card 模板预览</title>
    <style>
      @font-face {
        font-family: "Nishiki-teki";
        src: url("/assets/fonts/nishiki-teki.ttf") format("truetype");
        font-style: normal;
        font-weight: 400;
        font-display: swap;
      }

      @font-face {
        font-family: "Alimama ShuHeiTi";
        src: url("/assets/fonts/alimama-shu-hei-ti.woff2") format("woff2");
        font-style: normal;
        font-weight: 100 900;
        font-display: swap;
      }

      :root {
        --paper: #e5e6e6;
        --ink: #343638;
        --muted: #777a7b;
        --red: #f2483f;
        --red-deep: #d83835;
        --white: #fff;
        --body-font: "Alimama ShuHeiTi", "Microsoft YaHei", sans-serif;
        --brand-font: "Nishiki-teki", "Microsoft YaHei", sans-serif;
        --title-font: var(--body-font);
      }

      * { box-sizing: border-box; }
      html { min-width: 320px; background: #d7d8d8; }
      body {
        margin: 0;
        min-height: 100vh;
        color: var(--ink);
        font-family: var(--body-font);
        background:
          linear-gradient(rgba(255,255,255,.22) 1px, transparent 1px),
          linear-gradient(90deg, rgba(255,255,255,.22) 1px, transparent 1px),
          #d7d8d8;
        background-size: 48px 48px;
      }

      button, a { font: inherit; }
      button { cursor: pointer; }

      .page-shell {
        width: 100%;
        padding: 28px 16px 56px;
      }

      .link-card {
        isolation: isolate;
        position: relative;
        width: min(100%, 760px);
        min-height: 100vh;
        margin: 0 auto;
        overflow: hidden;
        padding: clamp(24px, 5vw, 58px) clamp(18px, 6vw, 62px) 32px;
        background:
          linear-gradient(rgba(94, 98, 99, .14) 1px, transparent 1px),
          linear-gradient(90deg, rgba(94, 98, 99, .14) 1px, transparent 1px),
          var(--paper);
        background-size: 48px 48px;
        border: 1px solid rgba(52, 54, 56, .14);
        box-shadow: 0 22px 60px rgba(35, 36, 37, .18);
      }

      .link-card::before,
      .link-card::after {
        content: "";
        position: absolute;
        z-index: -1;
        pointer-events: none;
        border-radius: 50%;
        background-image: radial-gradient(rgba(104, 108, 109, .22) 1.5px, transparent 1.8px);
        background-size: 13px 13px;
        opacity: .72;
      }

      .link-card::before {
        width: 560px;
        height: 560px;
        top: 230px;
        left: -310px;
        transform: rotate(20deg);
      }

      .link-card::after {
        width: 680px;
        height: 680px;
        top: -48px;
        right: -380px;
        transform: rotate(-16deg);
      }

      .brand-row {
        position: relative;
        z-index: 1;
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: 14px;
        margin-top: 0;
      }

      .top-copy {
        color: #fff;
        font-size: clamp(11px, 1.6vw, 16px);
        font-weight: 1000;
        line-height: 1.1;
        letter-spacing: .10em;
        -webkit-text-fill-color: #fff;
        -webkit-text-stroke: 2px #747778;
        paint-order: stroke fill;
      }

      .top-copy:last-child { text-align: right; }

      .brand-lockup {
        display: flex;
        align-items: flex-start;
        gap: 5px;
        color: #fff;
        font-family: var(--brand-font);
        font-size: clamp(18px, 3vw, 28px);
        font-weight: 400;
        line-height: .8;
        letter-spacing: .01em;
        -webkit-text-fill-color: #fff;
        -webkit-text-stroke: 2px #747778;
        paint-order: stroke fill;
      }

      .brand-mark { font-size: 1.2em; line-height: .8; }

      .profile {
        position: relative;
        z-index: 1;
        display: grid;
        grid-template-columns: minmax(142px, .72fr) 1.28fr;
        align-items: stretch;
        gap: clamp(20px, 5vw, 48px);
        margin-top: clamp(54px, 8vw, 82px);
        padding: clamp(18px, 3.5vw, 28px);
        color: #fff;
        background: var(--ink);
        border: 4px solid #fff;
        border-radius: 24px;
        box-shadow: 0 6px 0 rgba(52, 54, 56, .52);
      }

      .profile::after {
        content: "";
        position: absolute;
        inset: 7px;
        border: 1px solid rgba(255,255,255,.14);
        border-radius: 17px;
        pointer-events: none;
      }

      .logo-sticker {
        position: relative;
        z-index: 1;
        display: grid;
        height: 100%;
        min-height: 104px;
        place-items: center;
        padding: 14px 12px;
        background: #56595a;
        border: 2px solid rgba(255,255,255,.9);
        border-radius: 18px;
        box-shadow: 4px 4px 0 rgba(0,0,0,.14);
      }

      .logo-sticker img {
        display: block;
        width: 100%;
        height: auto;
        object-fit: contain;
      }

      .profile-copy {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        justify-content: center;
      }

      .profile h1 {
        margin: 0;
        font-family: var(--title-font);
        font-size: clamp(28px, 5vw, 46px);
        font-weight: 400;
        letter-spacing: -2px;
        line-height: .95;
        white-space: nowrap;
      }

      .handle {
        display: inline-block;
        margin-top: 14px;
        padding: 5px 13px;
        color: var(--ink);
        background: #fff;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 1000;
        letter-spacing: 2px;
      }

      .bio {
        margin: 14px 0 0;
        color: rgba(255,255,255,.8);
        font-size: 13px;
        font-weight: 700;
        line-height: 1.6;
      }

      .slogan {
        display: block;
        margin-top: 7px;
        color: rgba(255,255,255,.55);
        font-size: 10px;
        font-weight: 900;
        letter-spacing: 2px;
      }

      .link-panel {
        position: relative;
        z-index: 1;
        margin-top: 24px;
        padding: clamp(18px, 3.5vw, 28px);
        overflow: hidden;
        background:
          radial-gradient(circle at 18% 10%, rgba(255,255,255,.17) 0 2px, transparent 2.5px),
          radial-gradient(circle at 78% 82%, rgba(255,255,255,.12) 0 1.5px, transparent 2px),
          linear-gradient(138deg, #ff5a50, var(--red) 60%, #ff6751);
        background-size: 13px 13px, 17px 17px, auto;
        border: 4px solid #fff;
        border-radius: 30px;
        box-shadow: 0 8px 0 rgba(111, 61, 59, .2), 0 15px 28px rgba(64, 42, 42, .12);
      }

      .link-panel::after {
        content: "";
        position: absolute;
        inset: 9px;
        border: 1px solid rgba(255,255,255,.16);
        border-radius: 22px;
        pointer-events: none;
      }

      .panel-heading {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        color: #fff;
      }

      .panel-heading h2 { margin: 0; font-family: var(--title-font); font-size: clamp(24px, 4vw, 36px); font-weight: 400; letter-spacing: -1px; line-height: 1; }
      .panel-heading p { margin: 5px 0 0; font-size: 11px; font-weight: 800; opacity: .8; }

      .link-list {
        position: relative;
        z-index: 1;
        display: grid;
        gap: 10px;
        margin-top: 18px;
      }

      .link-row {
        display: flex;
        align-items: center;
        gap: 14px;
        width: 100%;
        min-height: 68px;
        padding: 8px 14px 8px 10px;
        color: var(--ink);
        background: #fff;
        border: 2px solid #fff;
        border-radius: 17px;
        box-shadow: 0 3px 0 rgba(112, 44, 42, .16);
        text-decoration: none;
        text-align: left;
        transition: transform .16s ease, box-shadow .16s ease;
      }

      button.link-row { appearance: none; }
      .link-row:hover, .link-row:focus-visible { transform: translateY(-2px); box-shadow: 0 5px 0 rgba(112, 44, 42, .18); }
      .link-row:active { transform: translateY(0) scale(.99); }

      .link-icon {
        flex: none;
        width: 46px;
        height: 46px;
        padding: 3px;
        background: #fff;
        border: 0;
        border-radius: 13px;
        box-shadow: none;
      }

      .link-icon img { display: block; width: 100%; height: 100%; border-radius: 10px; object-fit: cover; }
      .link-copy { flex: 1; min-width: 0; }
      .link-name { display: block; font-size: 16px; font-weight: 1000; }
      .link-desc { display: block; margin-top: 2px; color: #8a8b8c; font-size: 11px; font-weight: 700; }
      .link-arrow { flex: none; color: var(--accent); font-size: 20px; font-weight: 1000; }

      .poster-footer {
        position: relative;
        z-index: 1;
        display: flex;
        justify-content: space-between;
        gap: 12px;
        margin: 28px -62px -32px;
        padding: 18px clamp(18px, 6vw, 62px) 16px;
        color: rgba(255,255,255,.8);
        background: #56595a;
        font-size: 10px;
        letter-spacing: 1px;
      }

      .modal-mask {
        position: fixed;
        inset: 0;
        z-index: 10;
        display: grid;
        place-items: center;
        padding: 20px;
        background: rgba(28,29,30,.58);
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transition: opacity .18s ease, visibility .18s ease;
      }

      .modal-mask.show { opacity: 1; visibility: visible; pointer-events: auto; }

      .modal {
        width: min(100%, 430px);
        padding: 24px;
        background: #f7f7f5;
        border: 3px solid var(--red);
        border-radius: 22px;
        box-shadow: 0 14px 38px rgba(0,0,0,.24);
        transform: translateY(10px) scale(.97);
        transition: transform .18s ease;
      }

      .modal-mask.show .modal { transform: translateY(0) scale(1); }
      .modal h2 { margin: 0; font-size: 22px; }
      .modal p { margin: 8px 0 0; color: #666; font-size: 14px; line-height: 1.6; }

      .modal-post {
        display: grid;
        grid-template-columns: 58px 1fr;
        gap: 13px;
        margin-top: 18px;
        padding: 15px;
        background: #fff;
        border-radius: 18px;
      }

      .modal-post img { width: 58px; height: 58px; border-radius: 16px; object-fit: cover; }
      .modal-post strong { display: block; font-size: 15px; }
      .modal-post span { display: block; margin-top: 4px; color: #777; font-size: 12px; line-height: 1.5; }

      .modal-actions { display: flex; gap: 10px; margin-top: 18px; }
      .modal-actions button, .modal-actions a {
        flex: 1;
        display: grid;
        min-height: 44px;
        place-items: center;
        border: 0;
        border-radius: 13px;
        font-weight: 900;
        text-align: center;
        text-decoration: none;
      }

      .modal-close { color: #555; background: #e8e8e5; }
      .modal-open { color: #fff; background: var(--red); }

      @media (max-width: 600px) {
        .page-shell { padding: 14px 0 32px; }
        .link-card { width: 100%; border-right: 0; border-left: 0; }
        .brand-row { gap: 7px; }
        .top-copy { font-size: 10px; letter-spacing: .08em; -webkit-text-stroke: 1.5px #747778; }
        .brand-lockup { font-size: 17px; -webkit-text-stroke: 1.5px #747778; }
        .profile { grid-template-columns: 96px 1fr; gap: 15px; padding: 16px; border-width: 3px; }
        .profile h1 { font-size: clamp(24px, 7vw, 32px); letter-spacing: -1px; white-space: normal; }
        .bio { font-size: 12px; }
        .slogan { font-size: 8px; letter-spacing: 1px; }
        .link-panel { padding: 18px 14px; border-width: 3px; border-radius: 26px; }
        .panel-heading { align-items: flex-start; }
        .link-row { min-height: 68px; padding-right: 12px; }
        .link-icon { width: 46px; height: 46px; }
        .link-name { font-size: 16px; }
        .poster-footer { margin-left: -18px; margin-right: -18px; padding-left: 18px; padding-right: 18px; }
      }

      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after { scroll-behavior: auto !important; transition-duration: .01ms !important; }
      }
    </style>
  </head>
  <body>
    <main class="page-shell">
      <article class="link-card">
        <header class="brand-row" aria-label="CHANNEL MEAT">
          <span class="top-copy">做热情 有趣的制品</span>
          <span class="brand-lockup"><span class="brand-mark">✳</span><span>CHANNEL<br />MEAT</span></span>
          <span class="top-copy">去结识 有趣的队友</span>
        </header>

        <section class="profile" aria-labelledby="profile-title">
          <div class="logo-sticker">
            <img src="/assets/logo-meat.svg" alt="肉食狗小分队 Logo" />
          </div>
          <div class="profile-copy">
            <h1 id="profile-title">肉食狗小分队</h1>
            <span class="handle">CHANNEL MEAT</span>
            <p class="bio">Furry 制品社团 · 做热情有趣的制品 🐾<span class="slogan">SEEK FOR MEAT · STAY FOR MEET</span></p>
          </div>
        </section>

        <section class="link-panel" aria-labelledby="links-title">
          <div class="panel-heading">
            <div><h2 id="links-title">官方链接</h2><p>小红书 · 抖音 · 微博 · 淘宝店铺</p></div>
          </div>

          <nav class="link-list" aria-label="官方链接">
            {links.map((item) => (
              item.type === 'preview' ? (
                <button class="link-row" type="button" data-preview-key={item.key} style={`--accent:${item.accent}`} aria-label={`查看${item.name}最新动态预览`}>
                  <span class="link-icon"><img src={item.icon} alt={item.name} /></span>
                  <span class="link-copy"><span class="link-name">{item.name}</span><span class="link-desc">{item.desc}</span></span>
                  <span class="link-arrow">↗</span>
                </button>
              ) : (
                <button class="link-row" type="button" data-taobao="true" data-url={item.url} data-copy={taobaoShareText} style={`--accent:${item.accent}`}>
                  <span class="link-icon"><img src={item.icon} alt={item.name} /></span>
                  <span class="link-copy"><span class="link-name">{item.name}</span><span class="link-desc">{item.desc}</span></span>
                  <span class="link-arrow">⧉</span>
                </button>
              )
            ))}
          </nav>
        </section>

        <footer class="poster-footer">
          <span>@肉食狗小分队 · CHANNEL MEAT</span>
          <span>SEEK FOR MEAT · STAY FOR MEET</span>
        </footer>
      </article>
    </main>

    <div class="modal-mask" id="preview-mask" aria-hidden="true">
      <section class="modal" role="dialog" aria-modal="true" aria-labelledby="preview-title">
        <h2 id="preview-title">最新动态预览</h2>
        <p>这是 link card 的交互示意。接入快照后，这里可以展示平台最新一条内容。</p>
        <div class="modal-post">
          <img id="preview-icon" src={links[0].icon} alt="" />
          <div><strong id="preview-name">小红书</strong><span id="preview-copy">演示快照摘要会显示在这里，当前不代表实时内容。</span></div>
        </div>
        <div class="modal-actions"><button class="modal-close" id="preview-close" type="button">先看看</button><a class="modal-open" id="preview-open" href="#" target="_blank" rel="noopener noreferrer">打开平台</a></div>
      </section>
    </div>

    <div class="modal-mask" id="taobao-mask" aria-hidden="true">
      <section class="modal" role="dialog" aria-modal="true" aria-labelledby="taobao-title">
        <h2 id="taobao-title">淘宝店铺</h2>
        <p id="taobao-tip">淘口令已复制。打开淘宝后会自动跳转，若没有跳转请手动粘贴。</p>
        <div class="modal-post"><div style="display:grid;place-items:center;width:58px;height:58px;border-radius:16px;background:#fff0e8;color:#ff5000;font-size:27px;font-weight:1000">淘</div><div><strong id="taobao-code">{taokouling}</strong><span>肉食狗小分队官方店铺</span></div></div>
        <div class="modal-actions"><button class="modal-close" id="taobao-close" type="button">先逛逛</button><a class="modal-open" id="taobao-open" href={taobaoUrl} target="_blank" rel="noopener noreferrer">打开淘宝</a></div>
      </section>
    </div>

    <script>
      const previewData = {
        xhs: { name: '小红书', icon: '/assets/icons/apps/xhs.jpg', url: 'https://xhslink.cn/m/8mrKDfG2BuD', copy: '小红书演示快照：返图、评价与新的制品记录会在这里显示。' },
        douyin: { name: '抖音', icon: '/assets/icons/apps/douyin.jpg', url: 'https://v.douyin.com/9eig9TCj_-4/', copy: '抖音演示快照：最新视频标题和发布时间会在这里显示。' },
        weibo: { name: '微博', icon: '/assets/icons/apps/weibo.jpg', url: 'https://weibo.com/u/6042122549', copy: '微博演示快照：最新动态摘要会在这里显示。' },
      };

      const previewMask = document.getElementById('preview-mask');
      const taobaoMask = document.getElementById('taobao-mask');
      const previewClose = document.getElementById('preview-close');
      const taobaoClose = document.getElementById('taobao-close');
      const previewOpen = document.getElementById('preview-open');
      const previewIcon = document.getElementById('preview-icon');
      const previewName = document.getElementById('preview-name');
      const previewCopy = document.getElementById('preview-copy');
      const taobaoButton = document.querySelector('[data-taobao]');
      let lastTrigger = null;
      let activeMask = null;

      function closeMask(mask) {
        mask?.classList.remove('show');
        mask?.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
        lastTrigger?.focus();
        activeMask = null;
      }

      function openPreview(key, trigger) {
        const item = previewData[key];
        if (!item || !previewMask) return;
        lastTrigger = trigger;
        previewIcon.src = item.icon;
        previewIcon.alt = item.name;
        previewName.textContent = item.name;
        previewCopy.textContent = item.copy;
        previewOpen.href = item.url;
        previewMask.classList.add('show');
        previewMask.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
        activeMask = previewMask;
        previewClose?.focus();
      }

      async function copyText(text) {
        try {
          await navigator.clipboard.writeText(text);
          return true;
        } catch (_) {
          const textarea = document.createElement('textarea');
          textarea.value = text;
          textarea.style.position = 'fixed';
          textarea.style.opacity = '0';
          document.body.appendChild(textarea);
          textarea.select();
          let copied = false;
          try { copied = document.execCommand('copy'); } catch (_) { copied = false; }
          textarea.remove();
          return copied;
        }
      }

      document.querySelectorAll('[data-preview-key]').forEach((button) => {
        button.addEventListener('click', () => openPreview(button.dataset.previewKey, button));
      });
      taobaoButton?.addEventListener('click', async () => {
        const copied = await copyText(taobaoButton.dataset.copy || '');
        const tip = document.getElementById('taobao-tip');
        if (tip) tip.textContent = copied ? '淘口令已复制。打开淘宝后会自动跳转，若没有跳转请手动粘贴。' : '自动复制失败，请手动复制淘口令后打开淘宝。';
        lastTrigger = taobaoButton;
        taobaoMask?.classList.add('show');
        taobaoMask?.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
        activeMask = taobaoMask;
        taobaoClose?.focus();
      });
      previewClose?.addEventListener('click', () => closeMask(previewMask));
      taobaoClose?.addEventListener('click', () => closeMask(taobaoMask));
      [previewMask, taobaoMask].forEach((mask) => mask?.addEventListener('click', (event) => { if (event.target === mask) closeMask(mask); }));
      document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && activeMask) closeMask(activeMask); });
    </script>
  </body>
</html>
